decl {\#include "business_layer.h"
\#include "language.h"
\#include "sql_layer.h"
\#include "ui_v2_helpers.h"
\#include "ui_v2_scale.h"
\#include <FL/Fl_Browser.H>
\#include <FL/Fl_Choice.H>
\#include <FL/Fl_Group.H>
\#include <FL/Fl_Input_.H>
\#include <FL/Fl_Menu_.H>
\#include <FL/Fl_Menu_Bar.H>
\#include <FL/Fl_Output.H>
\#include <FL/Fl_Text_Display.H>
\#include <FL/fl_draw.H>
\#include <algorithm>
\#include <cmath>
\#include <cstdlib>
\#include <cstring>
\#include <map>
\#include <vector>

// ---------------------------------------------------------------------------
// Resize-aware layout scaling, kept here (in the .fl decl block) so FLUID
// regeneration always preserves it.
//
// FLTK's proportional child stretching is disabled. The UI is laid out from a
// snapshot of the original FLUID geometry: widget boxes and fonts scale with
// the window, positive gaps keep their pixel size from 1x upward and shrink
// below 1x, and label-only widgets follow their value displays so the flat GUI
// layout stays aligned.
// CARCALC_UI_SCALE overrides the derived factor.
// ---------------------------------------------------------------------------
namespace ui_v2_scaling {

struct Geometry
{
  Fl_Widget *widget;
  int x;
  int y;
  int w;
  int h;
  int nx;
  int ny;
  int nw;
  int nh;
  int index;
  int label_base;
  int label_original;
  int text_base;
  int text_original;
};

struct GroupSnapshot
{
  Fl_Widget *container;
  int y;
  std::vector<Geometry> children;
};

struct Row
{
  int top;
  int bottom;
  std::vector<Geometry *> items;
};

struct LabelAnchor
{
  Geometry *label;
  Geometry *anchor;
  int row;
  int font;
  int required;
  int width;
  int line;
};

struct BandCluster
{
  int start;
  int end;
  int band;
  int top;
  int line_height;
};

struct LayoutSize
{
  int width;
  int height;
};

Fl_Window *scaled_window = nullptr;
int base_width = 0;
int base_height = 0;
double factor = 1.0;
double applied_factor = 1.0;
bool poll_started = false;
std::vector<Geometry> window_snapshots;
std::vector<GroupSnapshot> group_snapshots;
std::map<Fl_Menu_Item *, int> menu_font_base;
std::map<Fl_Menu_Item *, int> menu_font_original;

int scaled_font_size(int size, double scale)
{
  if (size <= 0) return size;
  return std::max(1, static_cast<int>(std::lround(size * scale)));
}

void set_widget_text_size(Fl_Widget *widget, int size);
void apply_menu_fonts(const Fl_Menu_Item *items, double scale);

void apply_fonts_to_target(double scale)
{
  for (Geometry &item : window_snapshots)
  {
    item.widget->labelsize(scaled_font_size(item.label_base, scale));
    set_widget_text_size(item.widget, scaled_font_size(item.text_base, scale));
    if (Fl_Menu_ *menu = dynamic_cast<Fl_Menu_ *>(item.widget))
      apply_menu_fonts(menu->menu(), scale);
  }
  for (GroupSnapshot &snapshot : group_snapshots)
  {
    for (Geometry &item : snapshot.children)
    {
      item.widget->labelsize(scaled_font_size(item.label_base, scale));
      set_widget_text_size(item.widget, scaled_font_size(item.text_base, scale));
    }
  }
}

double clamp_scale(double value)
{
  // No upper cap: a maximized window on a large display must scale all the
  // way to that screen instead of leaving the UI in the top-left corner.
  return std::max(0.5, value);
}

bool env_scale(double *result)
{
  const char *value = std::getenv("CARCALC_UI_SCALE");
  if (!value || !*value || std::strcmp(value, "auto") == 0)
    return false;

  char *end = nullptr;
  const double parsed = std::strtod(value, &end);
  if (end == value || *end != '\\0' || parsed <= 0.0)
    return false;

  *result = clamp_scale(parsed);
  return true;
}

int scale_dim(int value, double scale)
{
  if (value <= 0) return value;
  return std::max(1, static_cast<int>(std::lround(value * scale)));
}

int scale_offset(int value, double scale)
{
  return static_cast<int>(std::lround(value * scale));
}


int widget_text_size(Fl_Widget *widget)
{
  if (Fl_Input_ *input = dynamic_cast<Fl_Input_ *>(widget)) return input->textsize();
  if (Fl_Browser *browser = dynamic_cast<Fl_Browser *>(widget)) return browser->textsize();
  if (Fl_Text_Display *display = dynamic_cast<Fl_Text_Display *>(widget)) return display->textsize();
  if (Fl_Menu_ *menu = dynamic_cast<Fl_Menu_ *>(widget)) return menu->textsize();
  return 0;
}

void set_widget_text_size(Fl_Widget *widget, int size)
{
  if (size <= 0) return;
  if (Fl_Input_ *input = dynamic_cast<Fl_Input_ *>(widget)) input->textsize(size);
  else if (Fl_Browser *browser = dynamic_cast<Fl_Browser *>(widget)) browser->textsize(size);
  else if (Fl_Text_Display *display = dynamic_cast<Fl_Text_Display *>(widget)) display->textsize(size);
  else if (Fl_Menu_ *menu = dynamic_cast<Fl_Menu_ *>(widget)) menu->textsize(size);
}

void capture_menu_fonts(const Fl_Menu_Item *items)
{
  for (const Fl_Menu_Item *item = items; item && item->label(); item = item->next())
  {
    Fl_Menu_Item *editable = const_cast<Fl_Menu_Item *>(item);
    const int size = editable->labelsize();
    if (size > 0 && !menu_font_base.count(editable))
    {
      menu_font_base[editable] = size;
      menu_font_original[editable] = size;
    }
    if (item->flags & FL_SUBMENU) capture_menu_fonts(item + 1);
    else if (item->flags & FL_SUBMENU_POINTER)
      capture_menu_fonts(static_cast<const Fl_Menu_Item *>(item->user_data()));
  }
}

void apply_menu_fonts(const Fl_Menu_Item *items, double scale)
{
  for (const Fl_Menu_Item *item = items; item && item->label(); item = item->next())
  {
    Fl_Menu_Item *editable = const_cast<Fl_Menu_Item *>(item);
    const auto base = menu_font_base.find(editable);
    if (base != menu_font_base.end() && base->second > 0)
      editable->labelsize(scaled_font_size(base->second, scale));
    if (item->flags & FL_SUBMENU) apply_menu_fonts(item + 1, scale);
    else if (item->flags & FL_SUBMENU_POINTER)
      apply_menu_fonts(static_cast<const Fl_Menu_Item *>(item->user_data()), scale);
  }
}

Geometry *geometry_of(Fl_Widget *widget)
{
  for (Geometry &item : window_snapshots)
    if (item.widget == widget) return &item;
  for (GroupSnapshot &snapshot : group_snapshots)
    for (Geometry &item : snapshot.children)
      if (item.widget == widget) return &item;
  return nullptr;
}

void set_widget_font_base(Fl_Widget *widget, int size)
{
  if (!widget) return;
  Geometry *item = geometry_of(widget);
  if (item) item->label_base = size;
  widget->labelsize(ui_v2_scaled_size(size));
}

void set_menu_font_base(Fl_Menu_Item *item, int size)
{
  if (!item) return;
  menu_font_base[item] = size;
  item->labelsize(ui_v2_scaled_size(size));
}

Geometry snapshot_of(Fl_Widget *widget)
{
  const int label = widget->labelsize();
  const int text = widget_text_size(widget);
  return {widget, widget->x(), widget->y(), widget->w(), widget->h(),
          widget->x(), widget->y(), widget->w(), widget->h(), -1,
          label, label, text, text};
}

void freeze_resize(Fl_Group *group)
{
  if (!group) return;
  group->resizable(nullptr);
  for (int i = 0; i < group->children(); ++i)
    freeze_resize(dynamic_cast<Fl_Group *>(group->child(i)));
}

void capture_layout(Fl_Window *window)
{
  window_snapshots.clear();
  group_snapshots.clear();

  for (int i = 0; i < window->children(); ++i)
  {
    Fl_Widget *child = window->child(i);
    Geometry window_item = snapshot_of(child);
    window_item.index = i;
    window_snapshots.push_back(window_item);
    if (Fl_Menu_ *menu = dynamic_cast<Fl_Menu_ *>(child))
      capture_menu_fonts(menu->menu());

    if (Fl_Group *group = dynamic_cast<Fl_Group *>(child))
    {
      GroupSnapshot group_snapshot;
      group_snapshot.container = group;
      group_snapshot.y = child->y();
      for (int j = 0; j < group->children(); ++j)
      {
        Geometry child_item = snapshot_of(group->child(j));
        child_item.index = j;
        group_snapshot.children.push_back(child_item);
      }
      group_snapshots.push_back(group_snapshot);
    }
  }
}

bool is_label_widget(const Geometry &item)
{
  const char *label = item.widget->label();
  if (!label || !*label) return false;

  if (dynamic_cast<Fl_Text_Display *>(item.widget)) return true;
  if (Fl_Output *output = dynamic_cast<Fl_Output *>(item.widget))
    return (!output->value() || !*output->value()) && item.h <= 2;
  return false;
}

int measured_label_width(Fl_Widget *widget, int size)
{
  const char *label = widget->label();
  if (!label || !*label) return 0;

  fl_font(widget->labelfont(), size);
  const double width = fl_width(label, static_cast<int>(std::strlen(label)));
  return std::max(1, static_cast<int>(std::lround(width)) + 4);
}

std::vector<Row> build_rows(GroupSnapshot &snapshot)
{
  std::vector<Row> rows;
  for (Geometry &item : snapshot.children)
  {
    if (is_label_widget(item)) continue;

    bool placed = false;
    for (Row &row : rows)
    {
      const int overlap = std::min(row.bottom, item.y + item.h) - std::max(row.top, item.y);
      if (overlap > 0)
      {
        row.items.push_back(&item);
        row.top = std::min(row.top, item.y);
        row.bottom = std::max(row.bottom, item.y + item.h);
        placed = true;
        break;
      }
    }
    if (!placed)
      rows.push_back({item.y, item.y + item.h, {&item}});
  }

  for (Row &row : rows)
  {
    std::sort(row.items.begin(), row.items.end(),
              [](const Geometry *a, const Geometry *b) { return a->x < b->x; });
  }
  std::sort(rows.begin(), rows.end(),
            [](const Row &a, const Row &b) { return a.top < b.top; });
  return rows;
}

int distance_to_rect(const Geometry &point, const Geometry &rect)
{
  const int cx = point.x + point.w / 2;
  const int cy = point.y + point.h / 2;
  const int dx = std::max(std::max(rect.x - cx, 0), cx - (rect.x + rect.w));
  const int dy = std::max(std::max(rect.y - cy, 0), cy - (rect.y + rect.h));
  return dx + dy;
}

int unscaled_font(const Geometry &item)
{
  const double current = applied_factor > 0.01 ? applied_factor : 1.0;
  return std::max(1, static_cast<int>(std::lround(item.widget->labelsize() / current)));
}

int layout_width(const GroupSnapshot &snapshot)
{
  if (scaled_window && scaled_window->w() > 0) return scaled_window->w();
  return snapshot.container ? snapshot.container->w() : 490;
}

void layout_group(GroupSnapshot &snapshot, double scale)
{
  const std::vector<Row> rows = build_rows(snapshot);
  if (rows.empty()) return;

  std::vector<int> row_top(rows.size(), 0);
  int next_row_top = scale_offset(rows.front().top, scale);
  for (std::size_t r = 0; r < rows.size(); ++r)
  {
    const Row &row = rows[r];
    row_top[r] = next_row_top;
    int bottom = next_row_top;
    int cursor_x = scale_offset(row.items.front()->x, scale);
    for (std::size_t i = 0; i < row.items.size(); ++i)
    {
      Geometry &item = *row.items[i];
      item.nw = scale_dim(item.w, scale);
      item.nh = scale_dim(item.h, scale);
      item.nx = cursor_x;
      item.ny = row_top[r] + scale_offset(item.y - row.top, scale);
      bottom = std::max(bottom, item.ny + item.nh);

      int gap = 0;
      if (i + 1 < row.items.size())
      {
        gap = row.items[i + 1]->x - (item.x + item.w);
        // Positive gaps are spacing and stay fixed at 1x and above. Below 1x
        // they shrink with the widgets so small windows still fit. Negative
        // gaps are intentional overlaps and always scale.
        if (gap < 0 || scale < 1.0) gap = scale_offset(gap, scale);
      }
      cursor_x = item.nx + item.nw + gap;
    }

    if (r + 1 < rows.size())
    {
      int gap = rows[r + 1].top - row.bottom;
      if (gap < 0 || scale < 1.0) gap = scale_offset(gap, scale);
      next_row_top = bottom + gap;
    }
  }

  // Label-only widgets are annotations for a nearby value widget. Follow
  // that value's laid-out position, otherwise fixed gaps move the value but
  // not its label and fields such as "Mixed price:" drift out of alignment.
  for (Geometry &label : snapshot.children)
  {
    if (!is_label_widget(label)) continue;
    label.nw = scale_dim(label.w, scale);
    label.nh = scale_dim(label.h, scale);

    Geometry *anchor = nullptr;
    int best_score = 1000000000;
    const char *text = label.widget->label();
    if (text && std::strchr(text, ':'))
    {
      for (Geometry &candidate : snapshot.children)
      {
        if (is_label_widget(candidate) || candidate.h <= 0) continue;
        // Only result displays are valid anchors; buttons and inputs can
        // share a row with a label but must not move it.
        if (!dynamic_cast<Fl_Output *>(candidate.widget) &&
            !dynamic_cast<Fl_Text_Display *>(candidate.widget)) continue;
        if (candidate.widget->label() && *candidate.widget->label()) continue;
        const int dx = candidate.x - label.x;
        const int dy = candidate.y - label.y;
        if (dy < -32 || dy > 8) continue;
        if (dx < -label.w / 2) continue;
        // Value boxes normally start just past the label's right edge and sit
        // 20 pixels above its baseline.
        const int score = std::abs(dx - label.w) + std::abs(dy + 20) * 3;
        if (score < best_score)
        {
          best_score = score;
          anchor = &candidate;
        }
      }
    }

    if (anchor)
    {
      label.nx = anchor->nx + scale_offset(label.x - anchor->x, scale);
      label.ny = anchor->ny + scale_offset(label.y - anchor->y, scale);
    }
    else
    {
      label.nx = scale_offset(label.x, scale);
      label.ny = scale_offset(label.y, scale);
    }
  }
}

struct TextRun
{
  int x;
  int y;
  int w;
  int h;
};

static std::vector<TextRun> *text_runs = nullptr;

// FLTK positions and wraps label text inside a widget box. Use its own draw
// callback to measure the resulting runs instead of guessing from fl_width().
void measure_run(const char *text, int length, int x, int y)
{
  if (!text_runs) return;
  int dx = 0;
  int dy = 0;
  int w = 0;
  int h = 0;
  fl_text_extents(text, length, dx, dy, w, h);
  if (w > 0 && h > 0) text_runs->push_back({x + dx, y + dy, w, h});
}

std::vector<TextRun> label_runs(const Geometry &item)
{
  std::vector<TextRun> runs;
  const char *text = item.widget->label();
  if (!text || !*text) return runs;

  const Fl_Boxtype box = item.widget->box();
  int x = item.nx + Fl::box_dx(box);
  int y = item.ny + Fl::box_dy(box);
  int w = item.nw - Fl::box_dw(box);
  int h = item.nh - Fl::box_dh(box);

  const Fl_Align align = item.widget->align();
  if (w > 11 && (align & (FL_ALIGN_LEFT | FL_ALIGN_RIGHT)))
  {
    x += 3;
    w -= 6;
  }

  fl_font(item.widget->labelfont(), item.widget->labelsize());
  text_runs = &runs;
  fl_draw(text, x, y, w, h, align, measure_run, nullptr, 0);
  text_runs = nullptr;
  return runs;
}

bool runs_overlap(const TextRun &a, const TextRun &b)
{
  const int dx = std::min(a.x + a.w, b.x + b.w) - std::max(a.x, b.x);
  const int dy = std::min(a.y + a.h, b.y + b.h) - std::max(a.y, b.y);
  return dx > 1 && dy > 1;
}

bool runs_collide(const std::vector<TextRun> &runs, const Geometry &item,
                  const std::vector<Geometry> &children)
{
  for (const Geometry &other : children)
  {
    if (other.widget == item.widget || is_label_widget(other)) continue;
    const TextRun box = {other.nx, other.ny, other.nw, other.nh};
    for (const TextRun &run : runs)
      if (runs_overlap(run, box)) return true;
  }
  for (const Geometry &other : children)
  {
    if (other.widget == item.widget || !other.widget->label() || !*other.widget->label())
      continue;
    const std::vector<TextRun> other_runs = label_runs(other);
    for (const TextRun &run : runs)
      for (const TextRun &other_run : other_runs)
        if (runs_overlap(run, other_run)) return true;
  }
  return false;
}

// Labels can still collide after scaling because translations are longer than
// English and because the original layout uses zero-height label widgets.
// Move label-only annotations first, then shrink only the colliding text until
// the measured runs no longer cover anything else.
void resolve_text(GroupSnapshot &snapshot, double scale)
{
  // Several passes let one widget's shrink make room for a neighbouring
  // label that was processed earlier in the same pass.
  for (int pass = 0; pass < 4; ++pass)
  {
    bool changed = false;
    for (Geometry &item : snapshot.children)
    {
      if (!item.widget->label() || !*item.widget->label()) continue;

      std::vector<TextRun> runs = label_runs(item);
      int guard = 0;
      while (runs_collide(runs, item, snapshot.children) && guard++ < 160)
      {
        bool moved = false;
        if (is_label_widget(item))
        {
          // Search in laid-out pixels so a scaled value box can be escaped.
          const int move_limit = std::max(160, scaled_font_size(160, scale));
          for (int distance = 1; distance <= move_limit && !moved; ++distance)
          {
            const int deltas[2] = {-distance, distance};
            for (int delta : deltas)
            {
              const int original_y = item.ny;
              item.ny += delta;
              const std::vector<TextRun> trial = label_runs(item);
              bool inside = true;
              if (scaled_window)
              {
                const int group_y = snapshot.container ? snapshot.container->y() : 0;
                const int absolute_y = group_y + item.ny;
                if (absolute_y < 0 || absolute_y + item.nh > scaled_window->h()) inside = false;
                for (const TextRun &run : trial)
                  if (run.y < 0 || run.y + run.h > scaled_window->h()) inside = false;
              }
              if (inside && !runs_collide(trial, item, snapshot.children))
              {
                runs = trial;
                moved = true;
                break;
              }
              item.ny = original_y;
            }
          }
        }
        if (moved) continue;

        const int size = item.widget->labelsize();
        const int minimum = scaled_font_size(4, scale);
        if (size > minimum)
        {
          item.widget->labelsize(size - 1);
          runs = label_runs(item);
          changed = true;
          continue;
        }
        break;
      }
    }
    if (!changed) break;
  }
}

void apply_layout(Fl_Window *window, double scale)
{
  // Font sizes are derived from captured (or translated) base sizes on every
  // pass, so collision-driven shrink adjustments never accumulate across
  // resizes or language changes.
  apply_fonts_to_target(scale);

  for (Geometry &item : window_snapshots)
  {
    const int y = scale_offset(item.y, scale);
    const int h = dynamic_cast<Fl_Group *>(item.widget)
                  ? std::max(1, window->h() - y) : scale_dim(item.h, scale);
    item.widget->resize(0, y, window->w(), h);
    item.nx = 0;
    item.ny = y;
    item.nw = window->w();
    item.nh = h;
  }

  for (GroupSnapshot &snapshot : group_snapshots)
  {
    layout_group(snapshot, scale);
    resolve_text(snapshot, scale);
    for (Geometry &item : snapshot.children)
      item.widget->resize(item.nx, item.ny, item.nw, item.nh);
  }
}

bool layout_drifted()
{
  for (const Geometry &item : window_snapshots)
  {
    if (item.widget->x() != item.nx || item.widget->y() != item.ny ||
        item.widget->w() != item.nw || item.widget->h() != item.nh)
      return true;
  }
  for (const GroupSnapshot &snapshot : group_snapshots)
  {
    for (const Geometry &item : snapshot.children)
    {
      if (item.widget->x() != item.nx || item.widget->y() != item.ny ||
          item.widget->w() != item.nw || item.widget->h() != item.nh)
        return true;
    }
  }
  return false;
}

LayoutSize layout_size(Fl_Window *window, double scale)
{
  LayoutSize size = {0, 0};
  for (const Geometry &item : window_snapshots)
  {
    size.width = std::max(size.width, scale_offset(item.x, scale) + scale_dim(item.w, scale));
    size.height = std::max(size.height, scale_offset(item.y, scale) + scale_dim(item.h, scale));
  }
  for (GroupSnapshot &snapshot : group_snapshots)
  {
    GroupSnapshot trial = snapshot;
    layout_group(trial, scale);
    for (const Geometry &item : trial.children)
    {
      size.width = std::max(size.width, item.nx + item.nw);
      size.height = std::max(size.height,
                             scale_offset(snapshot.y, scale) + item.ny + item.nh);
    }
  }
  (void)window;
  return size;
}

void apply_layout(Fl_Window *window, double scale);

LayoutSize actual_layout_size(Fl_Window *window, double scale)
{
  apply_layout(window, scale);
  LayoutSize size = {0, 0};
  for (const Geometry &item : window_snapshots)
  {
    size.width = std::max(size.width, item.widget->x() + item.widget->w());
    size.height = std::max(size.height, item.widget->y() + item.widget->h());
  }
  for (const GroupSnapshot &snapshot : group_snapshots)
  {
    for (const Geometry &item : snapshot.children)
    {
      size.width = std::max(size.width, item.widget->x() + item.widget->w());
      size.height = std::max(size.height,
                             snapshot.container->y() + item.widget->y() + item.widget->h());
    }
  }
  return size;
}

bool layout_fits(Fl_Window *window, double scale)
{
  const LayoutSize size = layout_size(window, scale);
  return size.width <= window->w() && size.height <= window->h();
}

double fitted_scale(Fl_Window *window, double scale)
{
  if (!window || group_snapshots.empty()) return scale;
  if (layout_fits(window, scale)) return scale;

  const double minimum = clamp_scale(0.5);
  double low = minimum;
  double high = scale;
  if (!layout_fits(window, low)) return low;

  for (int i = 0; i < 24; ++i)
  {
    const double mid = (low + high) / 2.0;
    if (layout_fits(window, mid)) low = mid;
    else high = mid;
  }
  return low;
}

double desired_scale()
{
  double fixed = 1.0;
  if (env_scale(&fixed)) return fixed;
  if (!scaled_window || base_width <= 0 || base_height <= 0) return 1.0;

  const double candidate = std::min(static_cast<double>(scaled_window->w()) / base_width,
                                    static_cast<double>(scaled_window->h()) / base_height);
  return fitted_scale(scaled_window, clamp_scale(candidate));
}

void refresh_scale()
{
  if (!scaled_window) return;

  const double target = desired_scale();
  // FLTK stretches the window's children whenever the window is resized,
  // even if the derived scale factor stays the same. Reapply the snapshot
  // layout in that case so the flat layout is restored immediately.
  if (!layout_drifted() && std::fabs(target - applied_factor) < 0.001) return;

  factor = target;
  apply_layout(scaled_window, target);
  applied_factor = target;
  scaled_window->redraw();
}

void poll_scale(void *)
{
  refresh_scale();
  Fl::repeat_timeout(0.05, poll_scale);
}

void scale_window(Fl_Window *window)
{
  if (!window) return;

  scaled_window = window;
  factor = 1.0;
  applied_factor = 1.0;

  capture_layout(window);

  // Keep the original FLUID window size unless the scaled flat layout needs
  // more room.
  const LayoutSize needed = layout_size(window, 1.0);
  const int initial_width = std::min(std::max(window->w(), needed.width), Fl::w());
  const int initial_height = std::min(std::max(window->h(), needed.height), Fl::h());
  if (initial_width != window->w() || initial_height != window->h())
    window->size(initial_width, initial_height);
  base_width = window->w();
  base_height = window->h();

  // Find the smallest factor whose layout still fits at the matching window
  // size, then let the WM resize freely from there up to the whole screen.
  double smallest_factor = 1.0;
  for (int step = 20; step >= 10; --step)
  {
    const double candidate = step / 20.0;
    const LayoutSize candidate_size = actual_layout_size(window, candidate);
    if (candidate_size.width <= scale_dim(base_width, candidate) &&
        candidate_size.height <= scale_dim(base_height, candidate))
      smallest_factor = candidate;
    else
      break;
  }
  const int min_width = scale_dim(base_width, smallest_factor);
  const int min_height = scale_dim(base_height, smallest_factor);
  if (Fl::w() > 0 && Fl::h() > 0)
    window->size_range(min_width, min_height, Fl::w(), Fl::h());
  else
    window->size_range(min_width, min_height);

  for (int i = 0; i < window->children(); ++i)
    freeze_resize(dynamic_cast<Fl_Group *>(window->child(i)));

  // The initial factor is 1, so refresh_scale() would otherwise consider it
  // unchanged and skip the first flat-layout pass.
  apply_layout(window, 1.0);
  refresh_scale();

  if (!poll_started)
  {
    Fl::add_timeout(0.05, poll_scale);
    poll_started = true;
  }
}

} // namespace ui_v2_scaling

double ui_v2_scale_factor()
{
  return ui_v2_scaling::factor;
}

int ui_v2_scaled_size(int size)
{
  return ui_v2_scaling::scaled_font_size(size, ui_v2_scaling::factor);
}

void ui_v2_relayout()
{
  if (!ui_v2_scaling::scaled_window) return;
  ui_v2_scaling::apply_layout(ui_v2_scaling::scaled_window, ui_v2_scaling::factor);
  ui_v2_scaling::scaled_window->redraw();
}

void ui_v2_scale_window(Fl_Window *window)
{
  ui_v2_scaling::scale_window(window);
}
\#include <FL/Fl_File_Chooser.H>
\#include <FL/fl_ask.H>
\#include <cctype>
\#include <filesystem>
\#include <iostream>
\#include <string>

static std::string ui_to_lower(std::string s)
{
  std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
  return s;
}

static int ui_match_score(const std::string &text, const std::string &query)
{
  if (query.empty()) return 0;
  std::string t = ui_to_lower(text);
  std::string q = ui_to_lower(query);
  if (t == q) return 100000;
  if (t.size() >= q.size() && t.compare(0, q.size(), q) == 0) return 90000 - static_cast<int>(t.size() - q.size());
  size_t pos = t.find(q);
  if (pos != std::string::npos) return 80000 - static_cast<int>(pos) * 100 - static_cast<int>(t.size() - q.size());

  // subsequence (fuzzy) match
  size_t ti = 0, qi = 0, first = std::string::npos, last = 0;
  while (ti < t.size() && qi < q.size())
  {
    if (t[ti] == q[qi])
    {
      if (first == std::string::npos) first = ti;
      last = ti;
      ++qi;
    }
    ++ti;
  }
  if (qi == q.size() && first != std::string::npos)
  {
    int span = static_cast<int>(last - first + 1);
    int gaps = span - static_cast<int>(q.size());
    return 70000 - span * 50 - gaps * 10 - static_cast<int>(first);
  }

  return 0;
}

static bool ui_match_better(const std::string &a, const std::string &b, const std::string &query)
{
  int sa = ui_match_score(a, query);
  int sb = ui_match_score(b, query);
  if (sa != sb) return sa > sb;
  std::string la = ui_to_lower(a);
  std::string lb = ui_to_lower(b);
  if (la != lb) return la < lb;
  return a < b;
}

static void replace_all_text(std::string &text, const std::string &from, const std::string &to)
{
  if (from.empty()) return;
  size_t pos = 0;
  while ((pos = text.find(from, pos)) != std::string::npos)
  {
    text.replace(pos, from.size(), to);
    pos += to.size();
  }
}

static std::string localize_price_text(std::string text)
{
  const std::string key = canonical_text(text);
  if (key == "N/A" || key == "N/D")
  {
    const char *translated = translate_cstr("N/A");
    return translated ? std::string(translated) : text;
  }
  const char *unit = translate_cstr("PLN/l");
  replace_all_text(text, "PLN/l", unit ? unit : "PLN/l");
  replace_all_text(text, "zł/l", unit ? unit : "PLN/l");
  return text;
}

static void translate_widget(Fl_Widget *widget)
{
  if (!widget) return;
  const char *label = widget->label();
  const std::string key = canonical_text(label ? label : "");
  const char *translated = translate_cstr(key.c_str());
  if (translated && (!label || std::strcmp(label, translated) != 0))
    widget->copy_label(translated);
  const int size = translation_size(key.c_str());
  ui_v2_scaling::Geometry *item = ui_v2_scaling::geometry_of(widget);
  if (size > 0) ui_v2_scaling::set_widget_font_base(widget, size);
  else if (item) ui_v2_scaling::set_widget_font_base(widget, item->label_original);

  Fl_Output *output = dynamic_cast<Fl_Output *>(widget);
  if (output && output->value())
  {
    const std::string localized = localize_price_text(output->value());
    if (localized != output->value()) output->value(localized.c_str());
  }
}

static void translate_menu_item(Fl_Menu_Item *item, const char *english)
{
  if (!item) return;
  item->label(translate_cstr(english));
  const int size = translation_size(english);
  const auto original = ui_v2_scaling::menu_font_original.find(item);
  if (size > 0) ui_v2_scaling::set_menu_font_base(item, size);
  else if (original != ui_v2_scaling::menu_font_original.end())
    ui_v2_scaling::set_menu_font_base(item, original->second);
}

static void translate_widget_group(Fl_Group *group)
{
  if (!group) return;
  for (int i = 0; i < group->children(); ++i)
    translate_widget(group->child(i));
}

// The DB has no urban/exurban columns, so show the real mixed consumption
// figure from conso_mixte_min/max. This is called whenever the selection
// changes, so the original Fuel usage readout is no longer left blank.
static void ui_v2_refresh_fuel_usage()
{
  if (!lbl_fuel_usage) return;
  const int brand_row = lst_car_models ? lst_car_models->value() : 0;
  const int model_row = lst_car_engines ? lst_car_engines->value() : 0;
  if (brand_row <= 0 || model_row <= 0)
  {
    lbl_fuel_usage->value("");
    return;
  }

  const char *brand_text = lst_car_models->text(brand_row);
  const char *model_text = lst_car_engines->text(model_row);
  if (!brand_text || !model_text)
  {
    lbl_fuel_usage->value("");
    return;
  }

  std::string gearbox;
  if (lst_car_gearboxes && lst_car_gearboxes->value() > 0)
  {
    const char *text = lst_car_gearboxes->text(lst_car_gearboxes->value());
    if (text) gearbox = text;
  }
  std::string energy;
  if (cbo_fuel_selectcar && cbo_fuel_selectcar->value() >= 0)
  {
    const char *text = cbo_fuel_selectcar->text(cbo_fuel_selectcar->value());
    if (text) energy = text;
  }

  lbl_fuel_usage->value(ui_v2_fuel_usage_text(brand_text, model_text, gearbox, energy).c_str());
}

void apply_language_to_ui()
{
  translate_menu_item(sbmnu_calculate, "Calculate");
  translate_menu_item(sbmnu_btn_selectcar, "Select Car");
  translate_menu_item(sbmnu_btn_calculate, "Calculate");
  translate_menu_item(mnu_btn_settings, "Settings");
  translate_menu_item(mnu_btn_file, "File");
  translate_menu_item(mnu_btn_help, "Help");
  translate_menu_item(mnu_btn_about, "About");
  translate_menu_item(mnu_btn_exit, "Exit");
  mnu_bar->redraw();

  translate_widget_group(grp_selectcar);
  translate_widget_group(grp_calculate);
  translate_widget_group(grp_settings);
  translate_widget_group(grp_download_data);
  ui_v2_relayout();
}

void refresh_language_choices()
{
  if (!cbo_language_settings) return;
  cbo_language_settings->clear();
  for (const LanguageInfo &language : available_languages())
    cbo_language_settings->add(language.name.c_str());
  cbo_language_settings->value(current_language_index());
}

void wake_grp_settings()
{
  refresh_language_choices();
  lbl_settings_status->value(active_translation_status().c_str());
  apply_language_to_ui();
}

void wake_grp_download_data()
{
  lbl_selected_db->value(database_path_for_current_language().c_str());
  lbl_download_status->value(translate_cstr("Ready"));
  apply_language_to_ui();
}

void language_changed()
{
  int choice = cbo_language_settings ? cbo_language_settings->value() : 0;
  set_language_by_index(choice);
  set_database_path(database_path_for_current_language());
  update_model_name("");
  update_engine_name("");
  update_gearbox_name("");
  update_vehicle_class("");
  update_fuel_type("");
  wake_grp_selectcar();
  wake_grp_settings();
  wake_grp_download_data();
  apply_language_to_ui();
}

void download_selected_database()
{
  const std::string source = database_path_for_current_language();
  if (!std::filesystem::exists(source))
  {
    const std::string message = std::string(translate_cstr("Database file not found: ")) + source;
    lbl_download_status->value(message.c_str());
    fl_alert("%s", message.c_str());
    return;
  }

  Fl_File_Chooser chooser(".", "*.db", Fl_File_Chooser::SINGLE | Fl_File_Chooser::CREATE,
                         translate_cstr("Choose where to save the database"));
  chooser.show();
  while (chooser.shown()) Fl::wait();
  const char *chosen = chooser.value();
  if (!chosen || !*chosen)
  {
    lbl_download_status->value(translate_cstr("Download cancelled"));
    return;
  }

  const std::string destination = chosen;
  if (std::filesystem::absolute(source) == std::filesystem::absolute(destination))
  {
    lbl_download_status->value(translate_cstr("The database is already in that location"));
    return;
  }

  try
  {
    std::filesystem::copy_file(source, destination, std::filesystem::copy_options::overwrite_existing);
    const std::string message = std::string(translate_cstr("Saved: ")) + destination;
    lbl_download_status->value(message.c_str());
  }
  catch (const std::exception &error)
  {
    const std::string message = std::string(translate_cstr("Download failed: ")) + error.what();
    lbl_download_status->value(message.c_str());
    fl_alert("%s", message.c_str());
  }
}} {
  comment {Includes all necessary headers for the entire program} private global
}

Function {action_cb(Fl_Widget*, void *data)} {
  comment {Button callback, calls functions based on the userdata it gets (which button was pressed)} open
} {
  code {const char *action = static_cast<const char*>(data); // get to a useable format (char)
  
  // based on what action is, call different function
  
  // switch group to grp_calc
  if (std::strcmp(action, "group_calculate") == 0)
  {
  	// prepare calculate group
  	apply_language_to_ui();
  	wake_grp_calculate();
  	// hide all other groups
  	hide_all_groups();
  	// switch group to grp_calculate
  	grp_calculate->show();
  }
  else if (std::strcmp(action, "group_selectcar") == 0)
  {
  	// prepare select function
  	apply_language_to_ui();
  	wake_grp_selectcar();
  	// hide all other groups
  	hide_all_groups();
  	// switch group to grp_selectcar
  	grp_selectcar->show();
  }
  else if (std::strcmp(action, "group_settings") == 0)
  {
  	wake_grp_settings();
  	hide_all_groups();
  	grp_settings->show();
  }
  else if (std::strcmp(action, "group_download_data") == 0)
  {
  	wake_grp_download_data();
  	hide_all_groups();
  	grp_download_data->show();
  }
  else if (std::strcmp(action, "language_changed") == 0)
  {
  	language_changed();
  }
  else if (std::strcmp(action, "download_db") == 0)
  {
  	download_selected_database();
  }
  else if (std::strcmp(action, "calculate") == 0) // calculate button pressed
  {
  	// call calculate function
  	calculate();
  }
  else if (std::strcmp(action, "proceed_car") == 0) // call proceed_car func
  {
  	proceed_car();
  }
  else if (std::strcmp(action, "search_car_models") == 0)
  {
  	search_car_models();
  }
  else if (std::strcmp(action, "search_car_engines") == 0)
  {
  	search_car_engines();
  }
  else if (std::strcmp(action, "search_car_gearboxes") == 0)
  {
  	search_car_gearboxes();
  }
  else if (std::strcmp(action, "clear_car") == 0)
  {
  	lst_car_models->value(0);
  	lst_car_engines->value(0);
  	lst_car_gearboxes->value(0);
  	ui_v2_refresh_fuel_usage();
  	wake_grp_selectcar();
  }
  else if (std::strcmp(action, "help_selectcar") == 0 ||
           std::strcmp(action, "help_calculate") == 0)
  {
  	fl_message("%s", translate_cstr("Pick a brand, model and gearbox, then choose class and fuel. Fuel usage shows the DB mixed figure in L/100 km."));
  }
  else if (std::strcmp(action, "exit") == 0)
  {
  	// ask if user wants to exit
  	int choice = fl_choice("%s",
  	                       translate_cstr("Leave"), translate_cstr("Stay"), NULL,
  	                       translate_cstr("Do you want to leave CarCalc?"));
  	// if yes - actually close app
  	if (choice == 0)
  	{
  		std::cout << "Bye from CarCalc! \\n";
  		if (Fl::first_window()) Fl::first_window()->hide();
  	}
  }} {}
}

Function {hide_all_groups()} {
  comment {Hides all groups} open
} {
  code {grp_selectcar->hide();
grp_calculate->hide();
 grp_settings->hide();
 grp_download_data->hide();} {}
}

Function {get_dto_selectcar()} {
  comment {Gets values from user, then passes them into DTO in business layer} open
} {
  code {// in select car
	// checks if everything is selected will be before this func, if they succeed - this func is called
	short idx = lst_car_models->value();
	std::string car_model = ""; std::string car_engine = ""; std::string car_gearbox = "";
	std::string car_class = ""; std::string car_fuel = "";
	// get car model
	if (idx > 0) //0 means argument not selected
	{
		car_model = lst_car_models->text(idx);
	}
	// get car engine
	idx = lst_car_engines->value();
	if (idx > 0) //0 means argument not selected
	{
		car_engine = lst_car_engines->text(idx);
	}
	// select car gearbox
	idx = lst_car_gearboxes->value();
	if (idx > 0) // 0 means nothing selected
	{
		car_gearbox = lst_car_gearboxes->text(idx);
	}
	// get class and fuel from cboBoxes
	idx = cbo_class_selectcar->value();
	if (idx >= 0) // -1 is nothing selected 
	{
		car_class = cbo_class_selectcar->text(idx);
	}
	idx = cbo_fuel_selectcar->value();
	if (idx >= 0) // -1 means nothing selected
	{
		car_fuel = cbo_fuel_selectcar->text(idx);	
	}
	std::cout << "Car info being passed to DTO: " << car_model << " " << car_engine << " " << car_gearbox << " " << car_class << " " << car_fuel << "\\n"; //make it actually output the data
	// call function from business layer
	receive_car_info(car_model, car_engine, car_gearbox, car_class, car_fuel);} {}
}

Function {calculate()} {open
} {
  code {// pass DTO to business layer
  std::string urban_str = txt_urban_usage->value();
  std::string exurban_str = txt_exurban_usage->value();
  std::string mixed_str = txt_mixed_usage->value();
  std::string co2_emission_str = txt_co2_emission->value();
  std::string price_str = txt_price->value();
  std::string distance_str = txt_distance_driven->value();
  // call calculation function
  business_calculate(urban_str, exurban_str, mixed_str, co2_emission_str, price_str, distance_str);
  // get calculated data (converted back to strings)
  std::vector<std::string> calculated_values = business_return_calculate();
  // show them in GUI
  // clear first so that no overlapping text is visible
  std::string tmp = "";
  lbl_urban_calculate->copy_label(tmp.c_str());
  lbl_exurban_calculate->copy_label(tmp.c_str());
  lbl_mixed_calculate->copy_label(tmp.c_str());
  lbl_co2emission_calculate->copy_label(tmp.c_str());
  lbl_average_price_calculate->copy_label(tmp.c_str());
  lbl_urban_price_calculate->copy_label(tmp.c_str());
  lbl_exurban_price_calculate->copy_label(tmp.c_str());
  lbl_mixed_price_calculate->copy_label(tmp.c_str());
  lbl_distance_calculate->copy_label(tmp.c_str());
  lbl_fuel_price_calculate->copy_label(tmp.c_str());
  //printf("label ptr: %p, parent: %p, window shown: %d\\n", (void*)lbl_urban_calculate, (void*)lbl_urban_calculate->parent(), lbl_urban_calculate->window() ? lbl_urban_calculate->window()->shown() : -1);
  // redraw them
    lbl_urban_calculate->redraw();
    lbl_exurban_calculate->redraw();
    lbl_mixed_calculate->redraw();
    lbl_co2emission_calculate->redraw();
    lbl_average_price_calculate->redraw();
    lbl_urban_price_calculate->redraw();
    lbl_exurban_price_calculate->redraw();
    lbl_mixed_price_calculate->redraw();
    lbl_distance_calculate->redraw();
    lbl_fuel_price_calculate->redraw();
  // fill with new values
  tmp = calculated_values[0];
  lbl_urban_calculate->value(tmp.c_str());
  tmp = calculated_values[1];
  lbl_exurban_calculate->value(tmp.c_str());
  tmp = calculated_values[2];
  lbl_mixed_calculate->value(tmp.c_str());
  tmp = calculated_values[3];
  lbl_co2emission_calculate->value(tmp.c_str());
  tmp = calculated_values[4];
  lbl_average_price_calculate->value(tmp.c_str());
  // 6, 7, 8 are urban, exurban and mixed prices
  tmp = calculated_values[5];
  lbl_urban_price_calculate->value(tmp.c_str());
  tmp = calculated_values[6];
  lbl_exurban_price_calculate->value(tmp.c_str());
  tmp = calculated_values[7];
  lbl_mixed_price_calculate->value(tmp.c_str());
  tmp = calculated_values[8]; 
  lbl_distance_calculate->value(tmp.c_str());
  // 9 is the government fuel price, or N/A until it is available
  tmp = localize_price_text(calculated_values[9]);
  lbl_fuel_price_calculate->value(tmp.c_str());} {}
}

Function {proceed_car()} {
  comment {Checks if all selected, if not - warns user, then passes DTO if user confirms} open
} {
  code {if (lst_car_models->value() == 0 || lst_car_engines->value() == 0 || lst_car_gearboxes->value() == 0 || cbo_class_selectcar->value() == -1 || cbo_fuel_selectcar->value() == -1)
{ // if any option is not selected
	// ask user if they want to proceed anyway
	int c = fl_choice("%s",
	translate_cstr("This is fine"), // button 0
	translate_cstr("Go back and select"), // button 1 (default selection)
	NULL,
	translate_cstr("Some options are not selected. Do you want to continue anyway?"));
	if (c == 0) // this is fine button pressed
	{
		// if yes, pass DTO and show grp_calculate
		get_dto_selectcar(); // should resolve fuel usage if not already
		wake_grp_calculate(); // clearing txtboxes, filling info etc.
		hide_all_groups();
		grp_calculate->show();
	}
}
else // if all are selected - just do it
{
		get_dto_selectcar(); // should resolve fuel usage if not alread
		wake_grp_calculate(); // clearing txtboxes, filling info etc.
		hide_all_groups();
		grp_calculate->show();
}} {}
}

