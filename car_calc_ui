Function {proceed_car()} {
  comment {Checks if all selected, if not - warns user, then passes DTO if user confirms} open
} {
  code {if (lst_car_models->value() == 0 || lst_car_engines->value() == 0 || lst_car_gearboxes->value() == 0 || cbo_class_selectcar->value() == -1 || cbo_fuel_selectcar->value() == -1)
{ // if any option is not selected
	// ask user if they want to proceed anyway
	int c = fl_choice("Some options are not selected. Do you want to continue anyway?",
	"This is fine", // button 0
	"Go back and select", // button 1 (default selection)
	NULL);
	if (c == 0) // this is fine button pressed
	{
		// if yes, pass DTO and show grp_calculate
		pass_dto("car_info");
		wake_grp_calculate(); // clearing txtboxes, filling info etc.
		hide_all_groups();
		grp_calculate->show();
	}
}
else // if all are selected - just do it
{
		pass_dto("car_info");
		wake_grp_calculate(); // clearing txtboxes, filling info etc.
		hide_all_groups();
		grp_calculate->show();
}} {}
}

