Function {action_cb(Fl_Widget*, void *data)} {
  comment {Button callback, calls functions based on the userdata it gets (which button was pressed)} open
} {
  code {const char *action = static_cast<const char*>(data); // get to a useable format (char)

// based on what action is, call different function

// switch group to grp_calc
if (std::strcmp(action, "group_calculate") == 0)
{
	// prepare calculate group
	wake_grp_calculate();
	// hide all other groups
	hide_all_groups();
	// switch group to grp_calculate
	grp_calculate->show();
}
else if (std::strcmp(action, "group_selectcar") == 0)
{
	// prepare select function
	wake_grp_selectcar();
	// hide all other groups
	hide_all_groups();
	// switch group to grp_selectcar
	grp_selectcar->show();
}
else if (std::strcmp(action, "calculate") == 0) // calculate button pressed
{
	// call calculate function
	calculate();
}
else if (std::strcmp(action, "proceed_car") == 0) // call proceed_car func
{
	proceed_car();
}
else if (std::strcmp(action, "search_car_models") == 0)
{
	search_car_models();
}
else if (std::strcmp(action, "search_car_engines") == 0)
{
	search_car_engines();
}
else if (std::strcmp(action, "search_car_gearboxes") == 0)
{
	search_car_gearboxes();
}
else if (std::strcmp(action, "select_car_model") == 0)
{
	on_select_car_model();
}
else if (std::strcmp(action, "select_car_engine") == 0)
{
	on_select_car_engine();
}
else if (std::strcmp(action, "select_car_gearbox") == 0)
{
	on_select_car_gearbox();
}} {}
}

Function {hide_all_groups()} {
  comment {Hides all groups} open
} {
  code {grp_selectcar->hide();
grp_calculate->hide();} {}
}

Function {get_dto_selectcar()} {
  comment {Gets values from user, then passes them into DTO in business layer} open
} {
  code {// in select car
	// checks if everything is selected will be before this func, if they succeed - this func is called
	short idx = lst_car_models->value();
	std::string car_model = ""; std::string car_engine = ""; std::string car_gearbox = "";
	std::string car_class = ""; std::string car_fuel = "";
	// get car model
	if (idx > 0) //0 means argument not selected
	{
		car_model = lst_car_models->text(idx);
	}
	// get car engine
	idx = lst_car_engines->value();
	if (idx > 0) //0 means argument not selected
	{
		car_engine = lst_car_engines->text(idx);
	}
	// select car gearbox
	idx = lst_car_gearboxes->value();
	if (idx > 0) // 0 means nothing selected
	{
		car_gearbox = lst_car_gearboxes->text(idx);
	}
	// get class and fuel from cboBoxes
	idx = cbo_class_selectcar->value();
	if (idx >= 0) // -1 is nothing selected 
	{
		car_class = cbo_class_selectcar->text(idx);
	}
	idx = cbo_fuel_selectcar->value();
	if (idx >= 0) // -1 means nothing selected
	{
		car_fuel = cbo_fuel_selectcar->text(idx);	
	}
	std::cout << "Car info being passed to DTO: " << car_model << " " << car_engine << " " << car_gearbox << " " << car_class << " " << car_fuel << "\\n"; //make it actually output the data
	// call function from business layer
	receive_car_info(car_model, car_engine, car_gearbox, car_class, car_fuel);} {}
}

Function {calculate()} {open
} {
  code {// pass DTO to business layer
  std::string urban_str = txt_urban_usage->value();
  std::string exurban_str = txt_exurban_usage->value();
  std::string mixed_str = txt_mixed_usage->value();
  std::string co2_emission_str = txt_co2_emission->value();
  std::string price_str = txt_price->value();
  std::string distance_str = txt_distance_driven->value();
  // call calculation function
  business_calculate(urban_str, exurban_str, mixed_str, co2_emission_str, price_str, distance_str);
  // get calculated data (converted back to strings)
  std::vector<std::string> calculated_values = business_return_calculate();
  // show them in GUI
  // clear first so that no overlapping text is visible
  std::string tmp = "";
  lbl_urban_calculate->copy_label(tmp.c_str());
  lbl_exurban_calculate->copy_label(tmp.c_str());
  lbl_mixed_calculate->copy_label(tmp.c_str());
  lbl_co2emission_calculate->copy_label(tmp.c_str());
  lbl_average_price_calculate->copy_label(tmp.c_str());
  lbl_urban_price_calculate->copy_label(tmp.c_str());
  lbl_exurban_price_calculate->copy_label(tmp.c_str());
  lbl_mixed_price_calculate->copy_label(tmp.c_str());
  lbl_distance_calculate->copy_label(tmp.c_str());
  //printf("label ptr: %p, parent: %p, window shown: %d\\n", (void*)lbl_urban_calculate, (void*)lbl_urban_calculate->parent(), lbl_urban_calculate->window() ? lbl_urban_calculate->window()->shown() : -1);
  // redraw them
    lbl_urban_calculate->redraw();
    lbl_exurban_calculate->redraw();
    lbl_mixed_calculate->redraw();
    lbl_co2emission_calculate->redraw();
    lbl_average_price_calculate->redraw();
    lbl_urban_price_calculate->redraw();
    lbl_exurban_price_calculate->redraw();
    lbl_mixed_price_calculate->redraw();
    lbl_distance_calculate->redraw();
  // fill with new values
  tmp = calculated_values[0];
  lbl_urban_calculate->value(tmp.c_str());
  tmp = calculated_values[1];
  lbl_exurban_calculate->value(tmp.c_str());
  tmp = calculated_values[2];
  lbl_mixed_calculate->value(tmp.c_str());
  tmp = calculated_values[3];
  lbl_co2emission_calculate->value(tmp.c_str());
  tmp = calculated_values[4];
  lbl_average_price_calculate->value(tmp.c_str());
  // 6, 7, 8 are urban, exurban and mixed prices
  tmp = calculated_values[5];
  lbl_urban_price_calculate->value(tmp.c_str());
  tmp = calculated_values[6];
  lbl_exurban_price_calculate->value(tmp.c_str());
  tmp = calculated_values[7];
  lbl_mixed_price_calculate->value(tmp.c_str());
  tmp = calculated_values[8]; 
  lbl_distance_calculate->value(tmp.c_str());} {}
}

Function {proceed_car()} {
  comment {Checks if all selected, if not - warns user, then passes DTO if user confirms} open
} {
  code {if (lst_car_models->value() == 0 || lst_car_engines->value() == 0 || lst_car_gearboxes->value() == 0 || cbo_class_selectcar->value() == -1 || cbo_fuel_selectcar->value() == -1)
{ // if any option is not selected
	// ask user if they want to proceed anyway
	int c = fl_choice("Some options are not selected. Do you want to continue anyway?",
	"This is fine", // button 0
	"Go back and select", // button 1 (default selection)
	NULL);
	if (c == 0) // this is fine button pressed
	{
		// if yes, pass DTO and show grp_calculate
		get_dto_selectcar();
		wake_grp_calculate(); // clearing txtboxes, filling info etc.
		hide_all_groups();
		grp_calculate->show();
	}
}
else // if all are selected - just do it
{
		get_dto_selectcar();
		wake_grp_calculate(); // clearing txtboxes, filling info etc.
		hide_all_groups();
		grp_calculate->show();
}} {}
}

