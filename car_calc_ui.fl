Function {wake_grp_selectcar()} {
  comment {Prepare select car group for being shown to user} open
} {
  code {// clear lst, txt and cboboxes
  lst_car_models->clear();
  lst_car_engines->clear();
  lst_car_gearboxes->clear();
  
  cbo_class_selectcar->clear();
  cbo_fuel_selectcar->clear();
  
  txt_search_car_models->value("");
  txt_search_car_engines->value("");
  txt_search_car_gearboxes->value("");
  
  // load car values from DTO if there are any
  // = get_from_dto(char which_dto, std::string what_to_get)
  // populate lists from database
  populate_car_models();} {}
}

Function {populate_car_models()} {open
} {
  code {lst_car_models->clear();
  std::vector<std::string> brands = business_get_all_brands();
  for (size_t i = 0; i < brands.size(); i++)
  {
    lst_car_models->add(brands[i].c_str());
  }
  // populate cboBoxes - search is done
populate_cboboxes_selectcar();} {}
}

Function {populate_car_engines()} {open
} {
  code {lst_car_engines->clear();
  short idx = lst_car_models->value();
  if (idx > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::vector<std::string> models = business_get_models_by_brand(brand);
    for (size_t i = 0; i < models.size(); i++)
    {
      lst_car_engines->add(models[i].c_str());
    }
  }
  // populate cboBoxes - search is done
populate_cboboxes_selectcar();} {}
}

Function {populate_car_gearboxes()} {open
} {
  code {lst_car_gearboxes->clear();
  short idx = lst_car_models->value();
  short idx2 = lst_car_engines->value();
  if (idx > 0 && idx2 > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::string model = lst_car_engines->text(idx2);
    std::vector<std::string> gearboxes = business_get_gearboxes_by_brand_model(brand, model);
    for (size_t i = 0; i < gearboxes.size(); i++)
    {
      lst_car_gearboxes->add(gearboxes[i].c_str());
    }
  }
  // populate cboBoxes - search is done
populate_cboboxes_selectcar();} {}
}

