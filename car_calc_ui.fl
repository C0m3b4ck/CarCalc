Function {browser_cb(Fl_Widget *w, short browser_type)} {
  comment {Callback for listboxes to get selected element} open
} {
  code {Fl_Browser *b = (Fl_Browser *)w;
int index = b->value(); // 0 is none
if (index > 0)
{
	const char *s = b->text(index);
	printf("Selected element from listbox with text: %s\\n", s);
	// decide which value (model, gearbox, engine) to update
	if (browser_type == 0) // model browser
	{
		update_model_name(s); // updated car model in struct in BL
	}
	else if (browser_type == 1) // engine browser
	{
		update_engine_name(s);	
	}
	else if (browser_type == 2) // gearbox browser
	{
		update_gearbox_name(s);	
	}
}} {}
}

Function {populate_cboboxes_selectcar()} {
  comment {Populate fuel type, class and fuel usage} open
} {
  code {lst_car_gearboxes->clear();
  short idx = lst_car_models->value();
  short idx2 = lst_car_engines->value();
  if (idx > 0 && idx2 > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::string model = lst_car_engines->text(idx2);
    std::vector<std::string> gearboxes = business_get_gearboxes_by_brand_model(brand, model);
    for (size_t i = 0; i < gearboxes.size(); i++)
    {
      lst_car_gearboxes->add(gearboxes[i].c_str());
    }
  }} {}
}

