Function {populate_car_models()} {open
} {
  code {lst_car_models->clear();
  std::vector<std::string> brands = business_get_all_brands();
  const char *q = txt_search_car_models ? txt_search_car_models->value() : "";
  if (q && *q)
  {
    std::string qs = q;
    std::stable_sort(brands.begin(), brands.end(), [&](const std::string &a, const std::string &b) { return ui_match_better(a, b, qs); });
  }
  for (size_t i = 0; i < brands.size(); i++)
  {
    lst_car_models->add(brands[i].c_str());
  }
  // populate cboBoxes - search is done
populate_cboboxes_selectcar();} {}
}

Function {populate_car_engines()} {open
} {
  code {lst_car_engines->clear();
  short idx = lst_car_models->value();
  if (idx > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::vector<std::string> models = business_get_models_by_brand(brand);
    const char *q = txt_search_car_engines ? txt_search_car_engines->value() : "";
    if (q && *q)
    {
      std::string qs = q;
      std::stable_sort(models.begin(), models.end(), [&](const std::string &a, const std::string &b) { return ui_match_better(a, b, qs); });
    }
    for (size_t i = 0; i < models.size(); i++)
    {
      lst_car_engines->add(models[i].c_str());
    }
  }
  // populate cboBoxes - search is done
populate_cboboxes_selectcar();} {}
}

Function {populate_car_gearboxes()} {open
} {
  code {lst_car_gearboxes->clear();
  short idx = lst_car_models->value();
  short idx2 = lst_car_engines->value();
  if (idx > 0 && idx2 > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::string model = lst_car_engines->text(idx2);
    std::vector<std::string> gearboxes = business_get_gearboxes_by_brand_model(brand, model);
    const char *q = txt_search_car_gearboxes ? txt_search_car_gearboxes->value() : "";
    if (q && *q)
    {
      std::string qs = q;
      std::stable_sort(gearboxes.begin(), gearboxes.end(), [&](const std::string &a, const std::string &b) { return ui_match_better(a, b, qs); });
    }
    for (size_t i = 0; i < gearboxes.size(); i++)
    {
      lst_car_gearboxes->add(gearboxes[i].c_str());
    }
  }
  // populate cboBoxes - search is done
populate_cboboxes_selectcar();} {}
}

Function {search_car_models()} {open
} {
  code {// return car models based on user search, sorted by match quality
populate_car_models();} {}
}

Function {search_car_engines()} {open
} {
  code {// return car engines based on user search, sorted by match quality
populate_car_engines();} {}
}

Function {search_car_gearboxes()} {open
} {
  code {// return car gearboxes based on user search, sorted by match quality
populate_car_gearboxes();} {}
}

Function {browser_cb(Fl_Widget *w, short browser_type)} {
  comment {Callback for listboxes to get selected element} open
} {
  code {Fl_Browser *b = (Fl_Browser *)w;
int index = b->value(); // 0 is none
if (index > 0)
{
	const char *s = b->text(index);
	printf("Selected element from listbox with text: %s\\n", s);
	// decide which value (model, gearbox, engine) to update
	if (browser_type == 0) // model browser
	{
		update_model_name(s); // updated car model in struct in BL
		populate_car_engines(); // refresh for QoL
	}
	else if (browser_type == 1) // engine browser
	{
		update_engine_name(s);	
		populate_car_gearboxes(); // refresh for QoL
	}
	else if (browser_type == 2) // gearbox browser
	{
		update_gearbox_name(s);	
		populate_cboboxes_selectcar(); // refresh for QoL
	}
}} {}
}

Function {populate_cboboxes_selectcar()} {
  comment {Populate fuel type, class and fuel usage} open
} {
  code {cbo_fuel_selectcar->clear();
cbo_class_selectcar->clear();
  // set indexes to 0 to indicate change
  cbo_fuel_selectcar->value(0);
  cbo_class_selectcar->value(0);
  // fill fuel type first
  short idx = lst_car_models->value();
  short idx2 = lst_car_engines->value();
  if (idx > 0 && idx2 > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::string model = lst_car_engines->text(idx2);
    std::vector<std::string> fuel_types = business_get_fuel_types_by_brand_model(brand, model);
    for (size_t i = 0; i < fuel_types.size(); i++)
    {
    	cbo_fuel_selectcar->add(fuel_types[i].c_str());
    }
  }
  // then fill vehicle class
  if (idx > 0 && idx2 > 0)
  {
    std::string brand = lst_car_models->text(idx);
    std::string model = lst_car_engines->text(idx2);
    std::vector<std::string> vehicle_classes = business_get_vehicle_classes_by_brand_model(brand, model);
    for (size_t i = 0; i < vehicle_classes.size(); i++)
    {
    	cbo_class_selectcar->add(vehicle_classes[i].c_str());
    }
  }
  refresh_fuel_usage();} {}
}

Function {cbobox_cb(Fl_Widget *o, short which_cbobox)} {
  comment {Callback for cboBoxes (needs cboBox name and cboBox number as args)} open
} {
  code {Fl_Choice *c = (Fl_Choice*)o;
int idx = c->value();
if (idx > 0)
{
	std::string selected_str = c->text(idx);
	// update DTO data based on which cboBox this is
	if (which_cbobox == 0) // vehicle class
	{
		update_vehicle_class(selected_str);
	}
	else if (which_cbobox == 1) // fuel type
	{
		update_fuel_type(selected_str);
	}
refresh_fuel_usage();
}} {}
}

Function {fill_from_dto_calculate()} {
  comment {Fill car info from DTO in calculate group} open
} {
  code {// get DTO info
  std::vector<std::string> car_info_vec = business_return_info();
  // set output lbls to received info
  // clear first so that no overlapping text is visible
  std::string tmp = "";
  lbl_modelname_calculate->copy_label(tmp.c_str());
  lbl_engine_calculate->copy_label(tmp.c_str());
  lbl_gearbox_calculate->copy_label(tmp.c_str());
  lbl_class_calculate->copy_label(tmp.c_str());
  lbl_fueltype_calculate->copy_label(tmp.c_str());
  txt_urban_usage->value(tmp.c_str());
  txt_exurban_usage->value(tmp.c_str());
  txt_mixed_usage->value(tmp.c_str());
  txt_co2_emission->value(tmp.c_str());
  // redraw them
  lbl_modelname_calculate->redraw();
  lbl_engine_calculate->redraw();
  lbl_gearbox_calculate->redraw();
  lbl_class_calculate->redraw();
  lbl_fueltype_calculate->redraw();
  txt_urban_usage->redraw();
  txt_exurban_usage->redraw();
  txt_mixed_usage->redraw();
  txt_co2_emission->redraw();
  // fill with new values
  tmp = car_info_vec[0];
  lbl_modelname_calculate->value(tmp.c_str());
  tmp = car_info_vec[1];
  lbl_engine_calculate->value(tmp.c_str());
  tmp = car_info_vec[2];
  lbl_gearbox_calculate->value(tmp.c_str());
  tmp = car_info_vec[3];
  lbl_class_calculate->value(tmp.c_str());
  tmp = car_info_vec[4];
  lbl_fueltype_calculate->value(tmp.c_str());
  // fill text fields with values
  std::vector<std::string> car_value_vec = business_return_values();
  tmp = car_value_vec[0];
  txt_urban_usage->value(tmp.c_str());
  tmp = car_value_vec[1];
  txt_exurban_usage->value(tmp.c_str());
  tmp = car_value_vec[2];
  txt_mixed_usage->value(tmp.c_str());
  tmp = car_value_vec[3];
  txt_co2_emission->value(tmp.c_str());} {}
}
